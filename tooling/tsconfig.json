{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "types": ["node", "@cloudflare/workers-types", "vinext/types"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "tsBuildInfoFile": "./.vinext/tsconfig.tsbuildinfo",
    "paths": {
      "@/*": ["../*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "../app/**/*.ts",
    "../app/**/*.tsx",
    "../backend/**/*.ts",
    "../database/**/*.ts",
    "../frontend/**/*.ts",
    "../frontend/**/*.tsx",
    "../shared/**/*.ts",
    "vite.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "../node_modules"]
}
